# *** MUST EXACTLY MATCH Batch_Bootstrap/Batch_Bootstrap.ino's
#     BOOTSTRAP_WIFI_SSID / BOOTSTRAP_WIFI_PASS ***
#
# A mismatch here is the #1 cause of a board stuck printing
# "WiFi join attempt timed out — retrying..." forever on Serial.
#
# Edit both places, every batch pass, to the same values.

BOOTSTRAP_AP_SSID="EDIT_BEFORE_FLASHING_SSID"
BOOTSTRAP_AP_PASS="EDIT_BEFORE_FLASHING_PASS"

# WiFi channel — fixed at 1 to match this project's established single-channel
# convention (ESP-NOW default, Bridge's AP) — the bootstrap's ESP-NOW pairing
# runs on whatever channel this AP uses, so keep it at 1.
BOOTSTRAP_AP_CHANNEL=1

# Bench-only, isolated subnet — deliberately NOT 192.168.4.0/24 (ESP32's own
# default softAP subnet, used by board_utility.ino's captive portal) and NOT
# 10.42.0.0/24 (NetworkManager's own hotspot default), so this network is never
# confusable with either.
BOOTSTRAP_AP_SUBNET_PREFIX="192.168.50"
BOOTSTRAP_AP_GATEWAY="192.168.50.1"
BOOTSTRAP_AP_DHCP_START="192.168.50.50"
BOOTSTRAP_AP_DHCP_END="192.168.50.150"
BOOTSTRAP_AP_LEASE_TIME="24h"
